# Copy to .env and fill in. Never commit .env.
DEVPILOT_PROVIDER=anthropic        # anthropic | openai | gemini | mock
DEVPILOT_MODEL=                    # optional override, e.g. claude-sonnet-5-5 or gpt-4.1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=                    # from Google AI Studio (aistudio.google.com)
GITHUB_TOKEN=                      # fine-grained PAT: Pull requests (read/write) + Contents (read)
GITHUB_WEBHOOK_SECRET=             # any long random string; same value in the GitHub webhook settings
